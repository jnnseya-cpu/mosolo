{
  "name": "@mosolo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts --demo",
    "start": "tsx src/persistence/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "start:persistent": "tsx src/persistence/server.ts",
    "start:demo": "tsx src/persistence/server.ts --demo",
    "db:backup": "tsx src/persistence/backup-cli.ts backup",
    "db:restore": "tsx src/persistence/backup-cli.ts restore",
    "db:verify": "tsx src/persistence/backup-cli.ts verify",
    "db:migrate": "tsx src/persistence/migrate-cli.ts",
    "bootstrap:check": "tsx src/persistence/bootstrap-cli.ts check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cors": "^10.0.0",
    "@mosolo/shared": "0.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.1.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "pg-mem": "^3.0.14",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
