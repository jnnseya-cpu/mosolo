# Sources envoyées à Cloud Build (gcloud builds submit --ignore-file=infra/gcp/.gcloudignore) : le strict nécessaire.
# Jamais de secrets, de dépendances installées ni de documents volumineux.
.git
.gitignore
.claude
node_modules
**/node_modules
frontend/dist
frontend/dev-dist
docs
mobile
coverage
**/*.log
.env
.env.*
**/*.pem
**/*.key
backend/data
infra/vps/.env
infra/vps/.etat
infra/vps/sauvegardes
infra/vps/amorcage
infra/gcp/.rendu
infra/static/.rendu
