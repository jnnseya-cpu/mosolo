# KINSHASA MOSOLO — variables NON SECRÈTES des prestataires de paiement pour Cloud Run (lues par infra/gcp/deploy.sh).
# Copier en infra/gcp/prestataires.env puis compléter. AUCUN SECRET ICI : clés API, secrets de webhook et clé Ed25519
# vont dans Secret Manager par ./infra/gcp/secrets-prestataires.sh <bitripay|koda> (deploy.sh refuse ces noms ici).
# Une ligne vide ou commentée garde la valeur par défaut du connecteur. Valeurs à confirmer avec chaque prestataire.

# --- BitriPay ---
# URL de l'API (défaut https://api.bitripay.com/v1, page développeur BitriPay : clés de test et réelles sur la même URL ;
# variantes documentées par l'OpenAPI : https://www.bitripay.com/api/v1, https://www.bitripay.com/v1)
#BITRIPAY_BASE_URL=https://api.bitripay.com/v1
# Alias du compte public de règlement inscrit au coffre (doit exister, sinon démarrage refusé)
#BITRIPAY_SETTLEMENT_ACCOUNT_ALIAS=KIN-DGIPK-RECETTES-01
# Opérateurs proposés au payeur (liste fournie par le prestataire)
#BITRIPAY_ALLOWED_OPERATORS=orange_cd,mpesa_cd,airtel_cd,africell_cd
# Compte connecté de la Ville (acct_…) seulement si la clé est celle d'un intégrateur
#BITRIPAY_ACCOUNT_ID=
# Décimales du CDF chez BitriPay : 0 ou 2 (défaut 2 — À CONFIRMER AVEC LE PRESTATAIRE)
#BITRIPAY_CDF_EXPONENT=2
#BITRIPAY_HMAC_REQUIRED=true
#BITRIPAY_ED25519_REQUIRED=false

# --- KODA ---
#KODA_BASE_URL=https://kodajnn.com/v1
#KODA_SETTLEMENT_ACCOUNT_ALIAS=KIN-DGIPK-RECETTES-01
#KODA_OPERATORS=orange_cd,mpesa_cd
# URL de retour du portail officiel (https, requise avec une clé KODA ; sans valeur probante)
#KODA_SUCCESS_URL=https://mosolo.exemple.cd/espace
