# =====================================================================================================================
# KINSHASA MOSOLO — variables d'environnement du déploiement VPS (infra/vps/docker-compose.yml)
# Copier en `.env` (droits 600, jamais versionné) : `cp .env.example .env && chmod 600 .env`, puis `./deploy.sh secrets`
# génère toutes les clés marquées « générée » (aucune valeur n'est affichée). AUCUNE VALEUR RÉELLE DANS CE FICHIER.
#
# Marques : « OBLIGATOIRE » = démarrage refusé sans elle (liste contrôlée par backend/test/deploiement.test.ts) ;
# « RECOMMANDÉE » = démarrage possible, avertissement et alerte sinon ; « FACULTATIVE » = fonction désactivée ou bac à
# sable sans elle. Référence complète : backend/README.md, « Variables d'environnement ».
# Les valeurs chiffrées (rétention, heures) sont PAR DÉFAUT — À CONFIRMER PAR LE MAÎTRE D'OUVRAGE.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# Déploiement (lu par docker compose et deploy.sh, pas par l'application)
# ---------------------------------------------------------------------------------------------------------------------
# Nom de domaine public (certificat HTTPS automatique par Caddy, Let's Encrypt). Enregistrement DNS A/AAAA vers le VPS.
MOSOLO_DOMAIN=mosolo.exemple.cd
# Adresse de contact Let's Encrypt (expiration des certificats).
MOSOLO_ACME_EMAIL=exploitation@exemple.cd
# Étiquette de l'image (fixée par deploy.sh à chaque version : mosolo:<commit>-<horodatage>).
MOSOLO_IMAGE_TAG=initiale
# Mémoire du tas Node pour la construction du frontend (Mo ; il en faut environ 700 ; 3072 par défaut).
MOSOLO_BUILD_HEAP_MB=3072

# ---------------------------------------------------------------------------------------------------------------------
# Base de données (conteneur postgres:16, volume persistant)
# ---------------------------------------------------------------------------------------------------------------------
# Rôle de MIGRATION (propriétaire des tables, superutilisateur du conteneur) et son mot de passe (générée).
POSTGRES_USER=mosolo_migration
POSTGRES_PASSWORD=
POSTGRES_DB=mosolo
# Rôle APPLICATIF (droits minimaux posés par la tâche de migration : jamais UPDATE/DELETE du journal) — mot de passe (générée).
MOSOLO_DB_APP_ROLE=mosolo_app
MOSOLO_DB_APP_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Application (production : jamais --demo, jamais MOSOLO_DEMO_MODE=true)
# ---------------------------------------------------------------------------------------------------------------------
# OBLIGATOIRE — mode production (refuse le mode démonstration, exige PostgreSQL).
NODE_ENV=production
# OBLIGATOIRE — connexion du rôle APPLICATIF (construite par deploy.sh à partir des valeurs ci-dessus ; hôte « postgres »).
DATABASE_URL=
# OBLIGATOIRE — clé privée Ed25519 PKCS#8 (PEM sur une ligne, « \n » échappés) de signature des quittances (générée).
MOSOLO_RECEIPT_SIGNING_KEY=
# OBLIGATOIRE — clé privée Ed25519 PKCS#8 des clôtures du Trésor, distincte de la précédente (générée).
MOSOLO_CLOSURE_SIGNING_KEY=
# OBLIGATOIRE — clé privée Ed25519 PKCS#8 des jetons d'accès (générée).
MOSOLO_JWT_PRIVATE_KEY=
# OBLIGATOIRE — clé HMAC du journal d'audit chaîné, 32 caractères minimum (générée).
MOSOLO_AUDIT_HMAC_KEY=
# OBLIGATOIRE — fichier de l'ancre externe de la chaîne d'audit, hors base (volume « mosolo_donnees »).
MOSOLO_AUDIT_ANCHOR_PATH=/var/lib/mosolo/ancre/ancre-audit.json
# OBLIGATOIRE — clé de signature des sauvegardes, distincte de toute autre clé (générée).
MOSOLO_BACKUP_KEY=
# OBLIGATOIRE — secret HMAC des rappels du prestataire mobile money (générée ; à remplacer par la valeur convenue avec le prestataire).
MOSOLO_PROVIDER_SECRET_MM_OPERATOR_A=
# OBLIGATOIRE — secret HMAC des rappels de la banque (générée ; à remplacer par la valeur convenue).
MOSOLO_PROVIDER_SECRET_BANK_A=
# OBLIGATOIRE — secret HMAC des rappels de la passerelle carte (générée ; à remplacer par la valeur convenue).
MOSOLO_PROVIDER_SECRET_CARD_GATEWAY=

# RECOMMANDÉE — scellement de l'identité des signalants (sinon repli sur la clé d'audit : séparation non assurée) (générée).
MOSOLO_INTEGRITE_KEY=
# RECOMMANDÉE — clé maîtresse des points de paiement agréés (sinon clé éphémère à chaque démarrage) (générée).
MOSOLO_PAYMENT_POINT_MASTER_KEY=
# RECOMMANDÉE — adresse publique officielle (QR des pages imprimables /l/imprimer).
MOSOLO_PUBLIC_URL=https://mosolo.exemple.cd
# RECOMMANDÉE — origines autorisées (CORS) ; même origine que l'application : l'adresse publique.
MOSOLO_CORS_ORIGINS=https://mosolo.exemple.cd
# RECOMMANDÉE — un mandataire inverse de confiance (Caddy) : adresse réelle des clients pour la limitation de débit.
MOSOLO_TRUST_PROXY=1
# RECOMMANDÉE — application web servie par l'API (un seul service).
MOSOLO_STATIC_DIR=frontend/dist
# RECOMMANDÉE — clés d'accès (passkeys) : domaine et origine publics.
MOSOLO_WEBAUTHN_RP_ID=mosolo.exemple.cd
MOSOLO_WEBAUTHN_ORIGINS=https://mosolo.exemple.cd
# RECOMMANDÉE — copie WORM de la chaîne d'audit par segments et publication des racines, hors base (volume).
MOSOLO_AUDIT_WORM_DIR=/var/lib/mosolo/worm
MOSOLO_AUDIT_ROOT_PUBLISH_PATH=/var/lib/mosolo/publication/racines-audit.jsonl
# RECOMMANDÉE — jeton de collecte des métriques Prometheus (/v1/plateforme/metrics) (générée).
MOSOLO_METRICS_TOKEN=

# FACULTATIVE — anciennes clés publiques des quittances encore acceptées (rotation), séparées par « ; ».
MOSOLO_RECEIPT_VERIFY_KEYS=
# FACULTATIVE — dates de mise en service des clés (âge contrôlé) : « MOSOLO_AUDIT_HMAC_KEY=2026-10-01,… ».
MOSOLO_KEY_DATES=
# FACULTATIVE — amorçage des comptes de travail et du coffre (fichier JSON monté en lecture seule dans /amorcage).
MOSOLO_BOOTSTRAP_FILE=
# FACULTATIVE — identifiants initiaux écrits une seule fois (0600) ; à remettre puis DÉTRUIRE.
MOSOLO_BOOTSTRAP_CREDENTIALS_OUT=
# FACULTATIVE — clés HMAC des terminaux de terrain « id=clé,id=clé ».
MOSOLO_DEVICE_KEYS=
# FACULTATIVE — passerelles SMS / SVI entrantes (signature HMAC).
SMS_GATEWAY_SECRET=
SVI_GATEWAY_SECRET=
# FACULTATIVE — WhatsApp (vérification du webhook et signature de l'application).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# FACULTATIVE — fournisseurs de communication (sans clé : canal en bac à sable « journalise »).
MOSOLO_EMAIL_PROVIDER_KEY=
MOSOLO_SMS_PROVIDER_KEY=
MOSOLO_PUSH_PROVIDER_KEY=
MOSOLO_WHATSAPP_PROVIDER_KEY=
MOSOLO_USSD_PROVIDER_KEY=
MOSOLO_SVI_PROVIDER_KEY=
MOSOLO_COURRIER_PROVIDER_KEY=
# FACULTATIVE — connecteurs de paiement KODA / BitriPay (voir backend/README.md ; sans secret de webhook : non enregistrés).
# Mode d'emploi complet (quoi demander au prestataire, où coller chaque valeur, adresse du webhook, essai, mise en
# service, retour au bac à sable) : docs/prestataires-paiement.md. Démarrage refusé en cas de configuration partielle
# (clé sans secret de webhook, clé KODA sans URL de retour, compte connecté sans clé, URL non https en réel).
# Adresses des webhooks à communiquer : ${MOSOLO_PUBLIC_URL}/v1/providers/koda/webhooks et …/bitripay/webhooks.
# KODA — clé SECRÈTE côté serveur (sk_… ; sk_live_… = réel). Jamais une clé publiable pk_….
KODA_API_KEY=
# KODA — secret HMAC des webhooks (en-tête x-koda-signature). Jamais « demo-whsec-koda ».
KODA_WEBHOOK_SECRET=
# KODA — URL de l'API (défaut https://kodajnn.com/v1 ; bac à sable : À CONFIRMER AVEC LE PRESTATAIRE).
KODA_BASE_URL=
# BitriPay — clé SECRÈTE côté serveur (sk_test_… bac à sable, sk_live_… réel).
BITRIPAY_API_KEY=
# BitriPay — secret whsec_… du point de terminaison de webhook (en-tête BitriPay-Signature). Jamais « demo-whsec-bitripay ».
BITRIPAY_WEBHOOK_SECRET=
# BitriPay — URL de l'API (défaut https://api.bitripay.com/v1 ; variantes documentées par l'OpenAPI :
# https://www.bitripay.com/api/v1, https://www.bitripay.com/v1).
BITRIPAY_BASE_URL=
# KODA — alias du compte public de règlement inscrit au coffre (défaut KIN-DGIPK-RECETTES-01 ; doit exister au coffre).
KODA_SETTLEMENT_ACCOUNT_ALIAS=
# KODA — opérateurs proposés (défaut orange_cd,mpesa_cd ; liste à obtenir du prestataire).
KODA_OPERATORS=
# KODA — URL de retour du portail officiel, en https (requise avec une clé KODA ; sans valeur probante).
KODA_SUCCESS_URL=
# BitriPay — clé publique Ed25519 de la plateforme (GET /v1/keys), PEM ou 32 octets base64 (facultative).
BITRIPAY_ED25519_PUBLIC_KEY=
# BitriPay — schémas de signature exigés (défauts : true, false).
BITRIPAY_HMAC_REQUIRED=
BITRIPAY_ED25519_REQUIRED=
# BitriPay — alias du compte public de règlement inscrit au coffre (défaut KIN-DGIPK-RECETTES-01).
BITRIPAY_SETTLEMENT_ACCOUNT_ALIAS=
# BitriPay — opérateurs proposés (défaut orange_cd,mpesa_cd,airtel_cd,africell_cd).
BITRIPAY_ALLOWED_OPERATORS=
# BitriPay — compte connecté acct_… de la Ville, seulement si la clé est celle d'un intégrateur.
BITRIPAY_ACCOUNT_ID=
# BitriPay — décimales du CDF : 0 ou 2 (défaut 2 — À CONFIRMER AVEC LE PRESTATAIRE).
BITRIPAY_CDF_EXPONENT=
# FACULTATIVE — horodatage tiers RFC 3161 (à raccorder) et livraison HTTP réelle des rappels partenaires.
MOSOLO_TSA_MODE=
MOSOLO_TSA_URL=
MOSOLO_WEBHOOK_DELIVERY=
# FACULTATIVE — émetteur OIDC public (défaut : adresse du serveur).
MOSOLO_OIDC_ISSUER=
# INTERDITES en production (démarrage refusé) : MOSOLO_DEMO_MODE=true, MOSOLO_DEMO_CREDENTIALS=true.

# ---------------------------------------------------------------------------------------------------------------------
# Sauvegardes (conteneur « sauvegarde » : outil existant `npm run db:backup`, sauvegarde JSON signée)
# ---------------------------------------------------------------------------------------------------------------------
# Heure quotidienne (heure de Kinshasa, 0-23) et rétention en jours — PAR DÉFAUT, À CONFIRMER PAR LE MAÎTRE D'OUVRAGE.
MOSOLO_BACKUP_HOUR=2
MOSOLO_BACKUP_RETENTION_DAYS=14
