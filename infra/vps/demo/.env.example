# =====================================================================================================================
# KINSHASA MOSOLO — démonstration sur VPS : copier en `.env` (droits 600, jamais versionné). ./demo.sh le fait.
# AUCUNE VALEUR RÉELLE DANS CE FICHIER. Les clés saisies ici SURVIVENT aux redémarrages (contrairement à la console
# « Clés et raccordements » de la démonstration, en mémoire) et priment sur la console.
# =====================================================================================================================

# Nom de domaine. Vide : ./demo.sh utilise <adresse-IP>.sslip.io (HTTPS valide sans acheter de domaine).
MOSOLO_DOMAIN=
# Adresse de contact Let's Encrypt (expiration des certificats).
MOSOLO_ACME_EMAIL=
# Adresse publique (webhooks, page de retour) : remplie par ./demo.sh à partir de MOSOLO_DOMAIN.
MOSOLO_PUBLIC_URL=
# Un seul mandataire (Caddy) devant l'application.
MOSOLO_TRUST_PROXY=1

# ---------------------------------------------------------------------------------------------------------------------
# Clés des prestataires — FACULTATIVES. Sans clé : paiement SIMULÉ (démonstration). Par prestataire, renseigner TOUTES
# ses clés ou aucune : un jeu incomplet empêche l'application de démarrer (./demo.sh le signale et montre le journal).
# Une valeur par ligne, sans espace ni guillemet. Clé Ed25519 : forme base64 sur une seule ligne, ou PEM aplati
# (« -----BEGIN PUBLIC KEY-----MCow…-----END PUBLIC KEY----- » sur une ligne).
# ---------------------------------------------------------------------------------------------------------------------
# BitriPay (les 3 ensemble)
BITRIPAY_API_KEY=
BITRIPAY_WEBHOOK_SECRET=
BITRIPAY_ED25519_PUBLIC_KEY=
# KODA (les 2 ensemble)
KODA_API_KEY=
KODA_WEBHOOK_SECRET=
# Intelligence artificielle (une seule suffit ; facultatives)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
