{
  "name": "kinshasa-mosolo",
  "private": true,
  "version": "0.1.0",
  "description": "KINSHASA MOSOLO — système d'exploitation souverain des recettes de la Ville Province de Kinshasa (socle logiciel)",
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "test": "python3 tools/verrou.py && npm run test --workspaces --if-present",
    "verrou": "python3 tools/verrou.py",
    "verrou:ajouter": "python3 tools/verrou.py --ajouter && MOSOLO_VERROU_AJOUTER=1 npm exec -w backend -- vitest run test/verrou-donnees-demo.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "gen": "python3 tools/gen_evenements.py && python3 tools/gen_graphiques.py"
  },
  "engines": { "node": ">=22.23.4 <23 || >=24.22.1 <25" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  }
}
